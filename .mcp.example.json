{
  "mcpServers": {
    "alphaxiv": {
      "type": "sse",
      "url": "https://mcp.alphaxiv.org"
    },
    "semantic-scholar": {
      "type": "stdio",
      "command": "npx",
      "args": ["@noesynth/semantic-scholar-mcp"],
      "env": {
        "SS_API_KEY": "<your-semantic-scholar-api-key-or-remove-this-line>"
      }
    }
  }
}
